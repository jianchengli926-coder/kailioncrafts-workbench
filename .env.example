# KaiLionCrafts AI客户开发工作台 - 环境变量配置
# 复制此文件为 .env 并填入你的API密钥

# ============ AI提供商选择 ============
# 可选: doubao (豆包/火山引擎方舟) 或 openai (OpenAI兼容接口)
AI_PROVIDER=doubao

# ============ 豆包API配置（推荐） ============
# 在火山引擎方舟平台获取: https://console.volcengine.com/ark
DOUBAO_API_KEY=your_doubao_api_key_here
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 主力模型（复杂任务：客户分析、开发信生成）
DOUBAO_MODEL=doubao-pro-32k
# 轻量模型（简单任务：分类、提取）
DOUBAO_MODEL_LITE=doubao-lite-32k

# ============ OpenAI兼容配置（如使用Codex/GPT） ============
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
